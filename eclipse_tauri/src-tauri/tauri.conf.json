{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DivineClient",
  "version": "0.3.2",
  "identifier": "com.divine.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DivineClient",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../mods": "mods"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5OTI2OTk1QUVBRDMzREYKUldUZk02MnVsV21TaVduTEFqUkYrWnp4K2VZVzRhaG5aWWVWT3QxUTJSeWUxVEhiSEdHRzhGaGYK",
      "endpoints": [
        "https://github.com/NoxilClient/eclipselauncher/releases/latest/download/latest.json"
      ]
    }
  }
}
